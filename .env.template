# AJSAA — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# cp .env.template .env && chmod 600 .env
# Fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Storage: Google Drive ─────────────────────────────────────────────────────
# Used when storage.provider=google_drive in config.yaml
# Option A (MCP — no credentials needed): Google Drive MCP connected in Claude Code session
# Option B (standalone): OAuth2 via google-auth-oauthlib
#   1. Go to console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID (Desktop app) → download JSON → save path below
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_CLIENT_SECRETS_PATH=.oauth_client.json   # downloaded from GCP console
GOOGLE_TOKEN_PATH=.token.json                   # auto-generated on first OAuth login

# ── Storage: OneDrive ─────────────────────────────────────────────────────────
# Used when storage.provider=onedrive in config.yaml
# Register an app at portal.azure.com → Azure Active Directory → App registrations
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=

# ── Storage: Dropbox ──────────────────────────────────────────────────────────
# Used when storage.provider=dropbox in config.yaml
# Generate at dropbox.com/developers → App Console → OAuth2 → Generated access token
DROPBOX_ACCESS_TOKEN=

# ── Email Notifications ───────────────────────────────────────────────────────
EMAIL_FROM=
EMAIL_TO=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_PASSWORD=

# ── Job Board Connectors ──────────────────────────────────────────────────────
# France Travail (official French gov API — free registration at francetravail.io/data/api)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Adzuna (global aggregator, strong France coverage — free at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Slack Notifications ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp Notifications (Twilio) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_WHATSAPP=
TWILIO_TO_WHATSAPP=
